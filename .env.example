# Online booking through Bimble. Copy to .env.local and fill in, then rebuild:
# the site is a static export, so these are baked in at build time.
#
# Bimble must also allow this site's address, e.g. in the Bimble API's env:
#   APP_CORS_ORIGINS=...,https://123walkin.com,http://localhost:3000

# Bimble API origin (no path).
NEXT_PUBLIC_BIMBLE_API_URL=https://api.bimble.pro

# The clinic's slug in Bimble. Leave empty to keep /book/ in demo mode.
NEXT_PUBLIC_BIMBLE_CLINIC_SLUG=
