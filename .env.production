# Online booking through Bimble (production). Read by `next build` and baked into
# the static site, so rebuild and re-upload after changing either value.
# Bimble must also list this site's address in APP_CORS_ORIGINS.

# Bimble API origin (no path).
NEXT_PUBLIC_BIMBLE_API_URL=https://api.bimble.pro

# The clinic's slug in Bimble: 123 Walk-In (2777 Gladwin Rd #108, Abbotsford).
NEXT_PUBLIC_BIMBLE_CLINIC_SLUG=oat-clinic-1
